generator client {
  provider = "prisma-client-js"
}

// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "../ERD.svg"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Verdict {
  ACCEPTED
  PENDING
  REJECTED
}

enum InterviewType {
  TECH
  NON_TECH
}

model UserData {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String?
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  InterviewSessions InterviewSession[]
  UserPerformances  UserPerformance[]
  AuthProvider      AuthProvider[]
  Submission        Submission[]
}

model AuthProvider {
  userId    String   @id
  googleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user UserData @relation(fields: [userId], references: [id])
}

model InterviewSession {
  id            String        @id @default(cuid())
  userId        String
  duration      Float
  interviewType InterviewType @default(TECH)
  problemSetId  String? // Optional field for problem set if it's a tech interview

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            UserData         @relation(fields: [userId], references: [id])
  problemSet      ProblemSet?      @relation(fields: [problemSetId], references: [id])
  userPerformance UserPerformance?
}

model ProblemSet {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String
  solution        String
  codeStub        String
  solutionArticle String?
  hasSolved       Boolean    @default(false)
  difficulty      Difficulty
  questionId      Int        @default(autoincrement())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  InterviewSessions InterviewSession[]
  Submission        Submission[]
  TestCase          TestCase[]
}

model ProblemTag {
  id   String @id @default(cuid())
  name String
}

model TestCase {
  id             String     @id @default(cuid())
  input          String
  expectedOutput String
  isDefault      Boolean
  problemSetId   String
  problemSet     ProblemSet @relation(fields: [problemSetId], references: [id])
}

model Language {
  id         String       @id @default(cuid())
  name       String
  judge0Id   Int
  Submission Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  userId       String
  problemSetId String
  code         String
  runtime      Float
  memory       Float
  verdict      Verdict  @default(PENDING)
  languageId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  language   Language   @relation(fields: [languageId], references: [id])
  user       UserData   @relation(fields: [userId], references: [id])
  problemSet ProblemSet @relation(fields: [problemSetId], references: [id])
}

model UserPerformance {
  id          String @id @default(cuid())
  userId      String
  interviewId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      UserData         @relation(fields: [userId], references: [id])
  interview InterviewSession @relation(fields: [interviewId], references: [id])

  // Metrics relations
  communicationMetrics    CommunicationMetrics?
  criticalThinkingMetrics CriticalThinkingMetrics?
  codeQualityMetrics      CodeQualityMetrics?
  runtimeAnalysisMetrics  RuntimeAnalysisMetrics?
}

model CommunicationMetrics {
  id                String @id @default(cuid())
  userPerformanceId String @unique
  fillerWords       Int
  articulationRate  Float
  speechRate        Float
  numberofPauses    Int
  stressPoints      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userPerformance UserPerformance @relation(fields: [userPerformanceId], references: [id])
}

model CriticalThinkingMetrics {
  id                String @id @default(cuid())
  userPerformanceId String @unique
  score             Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userPerformance UserPerformance @relation(fields: [userPerformanceId], references: [id])
}

model CodeQualityMetrics {
  id                String @id @default(cuid())
  userPerformanceId String @unique
  codeStructure     Int
  logicAccuracy     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userPerformance UserPerformance @relation(fields: [userPerformanceId], references: [id])
}

model RuntimeAnalysisMetrics {
  id                String @id @default(cuid())
  userPerformanceId String @unique
  timeComplexity    String
  spaceComplexity   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userPerformance UserPerformance @relation(fields: [userPerformanceId], references: [id])
}
