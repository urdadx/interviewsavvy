	"main": "index.js",
	"scripts": {
		"dev": "nodemon -r dotenv/config src/index.ts dotenv_config_path=./.env.local dontenv_config_debug=true",
		"start": "node -r dotenv/config dist/index.js dotenv_config_path=./.env.local dontenv_config_debug=true",
		"test": "echo \"Error: no test specified\" && exit 1",
		"lint": "pnpm biome lint --write ./src",
		"format": "pnpm biome format --write ./src",
		"lint-check": "pnpm biome lint ./src",
		"format-check": "pnpm biome format ./src",
		"migrate-dev": "pnpm dotenv -e .env.local -- pnpm prisma migrate dev --preview-feature",
		"generate": "pnpm dotenv -e .env.local -- pnpm prisma generate",
		"db-pull": "pnpm dotenv -e .env.local -- pnpm prisma db pull",
		"db-push": "pnpm dotenv -e .env.local -- pnpm prisma db push",
		"studio": "pnpm dotenv -e .env.local -- pnpm prisma studio"
	},
